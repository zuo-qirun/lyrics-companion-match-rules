{
  "schemaVersion": 1,
  "id": "general.numeric-suffix",
  "name": "通用：去掉标题末尾数字序号",
  "version": 1,
  "author": "lyrics-companion",
  "description": "标题末尾带（01）/(01)/【01】等括号序号，或「 - 01」「 01」这类分隔符序号时去掉序号，保留歌名；只处理标题，不改歌手。",
  "minVersionCode": 0,
  "scope": {
    "packages": [],
    "sources": []
  },
  "rules": [
    {
      "id": "strip-bracket-index",
      "when": [
        {
          "field": "title",
          "op": "regex",
          "value": "^.{1,120}[（(【\\[]\\s*\\d{1,3}\\s*[)）】\\]]\\s*$"
        }
      ],
      "then": [
        {
          "type": "stripSuffix",
          "field": "title",
          "pattern": "[（(【\\[]\\s*\\d{1,3}\\s*[)）】\\]]\\s*$"
        },
        {
          "type": "trim",
          "field": "title"
        }
      ]
    },
    {
      "id": "strip-separator-index",
      "when": [
        {
          "field": "title",
          "op": "regex",
          "value": "^.{1,120}[\\s_\\-–—·]+\\d{1,3}$"
        }
      ],
      "then": [
        {
          "type": "stripSuffix",
          "field": "title",
          "pattern": "[\\s_\\-–—·]+\\d{1,3}$"
        },
        {
          "type": "trim",
          "field": "title"
        }
      ]
    }
  ]
}

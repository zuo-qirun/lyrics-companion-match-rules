{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lyrics Companion 元数据匹配规则包",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "rules"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "version": {"type": "integer", "minimum": 1, "maximum": 9999},
    "author": {"type": "string", "maxLength": 40},
    "description": {"type": "string", "maxLength": 200},
    "minVersionCode": {"type": "integer", "minimum": 0, "maximum": 999999},
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "packages": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[A-Za-z0-9._]+$"}},
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {"enum": ["netease", "qqmusic", "kugou", "kuwo", "soda", "migu"]}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "then"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 40},
          "when": {"type": "array", "maxItems": 6, "items": {"$ref": "#/definitions/condition"}},
          "then": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/definitions/action"}}
        }
      }
    }
  },
  "definitions": {
    "condition": {
      "type": "object",
      "required": ["field", "op"],
      "additionalProperties": true,
      "properties": {
        "field": {"enum": ["title", "artist", "album", "package", "source"]},
        "op": {"enum": ["equals", "equalsAny", "contains", "containsAny", "startsWith", "endsWith", "regex", "empty"]},
        "value": {"type": ["string", "array"]}
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {"enum": ["extract", "replace", "set", "clear", "trim", "stripSuffix", "aliasArtist"]},
        "field": {"enum": ["title", "artist", "album"]},
        "pattern": {"type": "string", "maxLength": 200},
        "replacement": {"type": "string"},
        "value": {"type": "string"},
        "all": {"type": "boolean"},
        "targets": {"type": "object"},
        "map": {"type": "object"}
      }
    }
  }
}
